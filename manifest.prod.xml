<?xml version="1.0" encoding="UTF-8"?>
<!-- PRODUCTION manifest for AppSource submission.
     Served from GitHub Pages: https://yech14.github.io/delta-excel/
     The dev manifest (manifest.xml, localhost, different Id) can stay
     sideloaded alongside this one without conflict. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
           xsi:type="TaskPaneApp">

  <Id>b1eb401f-74f1-44c7-9c69-669303fa5421</Id>
  <Version>1.0.0</Version>
  <ProviderName>Yechiel</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Delta"/>
  <Description DefaultValue="Version history for Excel. Review every change cell by cell, save named versions, and revert safely — everything stays on your computer."/>
  <IconUrl DefaultValue="https://yech14.github.io/delta-excel/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://yech14.github.io/delta-excel/assets/icon-80.png"/>
  <SupportUrl DefaultValue="https://yech14.github.io/delta-excel/site/support.html"/>

  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>

  <Requirements>
    <Sets DefaultMinVersion="1.3">
      <Set Name="ExcelApi" MinVersion="1.3"/>
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://yech14.github.io/delta-excel/src/taskpane.html"/>
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <!-- Shared runtime: the add-in keeps running after the pane is closed,
             so it can clean up in-grid highlights the moment the pane goes
             hidden. Hosts without SharedRuntime support simply ignore this. -->
        <Runtimes>
          <Runtime resid="Delta.PaneUrl" lifetime="long"/>
        </Runtimes>
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="Delta.Group">
                <Label resid="Delta.GroupLabel"/>
                <Icon>
                  <bt:Image size="16" resid="Delta.Icon16"/>
                  <bt:Image size="32" resid="Delta.Icon32"/>
                  <bt:Image size="80" resid="Delta.Icon80"/>
                </Icon>
                <Control xsi:type="Button" id="Delta.OpenPane">
                  <Label resid="Delta.ButtonLabel"/>
                  <Supertip>
                    <Title resid="Delta.ButtonLabel"/>
                    <Description resid="Delta.ButtonTip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Delta.Icon16"/>
                    <bt:Image size="32" resid="Delta.Icon32"/>
                    <bt:Image size="80" resid="Delta.Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>Delta.Pane</TaskpaneId>
                    <SourceLocation resid="Delta.PaneUrl"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Delta.Icon16" DefaultValue="https://yech14.github.io/delta-excel/assets/icon-16.png"/>
        <bt:Image id="Delta.Icon32" DefaultValue="https://yech14.github.io/delta-excel/assets/icon-32.png"/>
        <bt:Image id="Delta.Icon80" DefaultValue="https://yech14.github.io/delta-excel/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Delta.PaneUrl" DefaultValue="https://yech14.github.io/delta-excel/src/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Delta.GroupLabel" DefaultValue="Delta"/>
        <bt:String id="Delta.ButtonLabel" DefaultValue="Delta"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Delta.ButtonTip" DefaultValue="See every change since your last version before you save."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
